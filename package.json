{
  "name": "@bilhanah/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "dashboard"
  ],
  "scripts": {
    "postinstall": "npm run build -w @bilhanah/contracts",
    "dev": "vite --host 127.0.0.1",
    "dev:dashboard": "npm run dev -w @bilhanah/restaurant-dashboard",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && npm run typecheck -w @bilhanah/restaurant-dashboard",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:dashboard": "npm test -w @bilhanah/restaurant-dashboard",
    "test:dashboard:e2e": "npm run test:e2e -w @bilhanah/restaurant-dashboard"
  },
  "dependencies": {
    "@bilhanah/contracts": "0.1.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "socket.io-client": "4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
