# NestJS API origin. Required for production builds (vite build refuses to run without it).
VITE_API_URL=http://127.0.0.1:3000
# Restaurants are served at {subdomain}.VITE_ROOT_DOMAIN. Production: bilhanah.com
VITE_ROOT_DOMAIN=localhost
# Dashboard origin. Leave empty until registration is publicly available;
# the landing page then shows its "registration coming soon" notice.
VITE_DASHBOARD_URL=
# Public contact channels for the contact page. WhatsApp in international format, e.g. 201001234567.
VITE_CONTACT_EMAIL=hello@bilhanah.com
VITE_CONTACT_WHATSAPP=
